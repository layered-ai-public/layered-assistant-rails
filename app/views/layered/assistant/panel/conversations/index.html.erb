<%= render "layered/assistant/panel/conversations/header", assistants: @assistants, conversations: @conversations, selected: layered_assistant.panel_conversations_path %>

<%= turbo_frame_tag "assistant_panel" do %>
  <%= l_ui_table(@conversations,
        caption: "Conversations in panel",
        columns: [
          { attribute: :created_at, label: "Created", render: ->(c) { c.created_at.to_fs(:short) } },
          { attribute: :name, primary: true, render: ->(c) { link_to c.name, layered_assistant.panel_conversation_path(c), data: { turbo_frame: "assistant_panel", turbo_prefetch: false } } },
          { attribute: :messages_count, label: "Messages", render: ->(c) { link_to c.messages_count || 0, layered_assistant.conversation_messages_path(c), data: { turbo_frame: "_top", turbo_prefetch: false } } },
          { attribute: :token_estimate, label: "Tokens", render: ->(c) { number_with_delimiter(c.token_estimate.to_i) } }
        ],
        actions: ->(c) { button_to "Delete", layered_assistant.panel_conversation_path(c), method: :delete, class: "l-ui-table__action l-ui-table__action--danger", data: { turbo_confirm: "Delete this conversation?" } },
        floating_actions: true
      ) %>
<% end %>
