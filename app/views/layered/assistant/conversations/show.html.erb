<div class="l-ui-conversation__container">
  <div class="l-ui-spread">
    <h1 class="<%= dom_id(@conversation) %>_name"><%= @conversation.name %></h1>
    <%= link_to "Back", layered_assistant.conversations_path, class: "l-ui-button l-ui-button--outline" %>
  </div>

  <%= render "layered/assistant/conversations/conversation", conversation: @conversation, messages: @messages, models: @models, selected_model_id: @selected_model_id %>
</div>
