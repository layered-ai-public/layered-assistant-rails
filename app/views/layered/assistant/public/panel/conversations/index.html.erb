<%= render "layered/assistant/public/panel/conversations/header", assistant: @assistant, conversations: @conversations, selected: :index %>

<%= turbo_frame_tag "assistant_panel" do %>
  <div class="l-assistant-panel__lobby">
    <h2 class="l-ui-heading--md"><%= @assistant.name %></h2>

    <% if @assistant.description.present? %>
      <p class="l-ui-text"><%= @assistant.description %></p>
    <% end %>

    <% if @conversations.any? %>
      <%= l_ui_table(@conversations,
            caption: "Your conversations",
            columns: [
              { attribute: :created_at, label: "Created", render: ->(c) { c.created_at.to_fs(:short) } },
              { attribute: :name, primary: true, render: ->(c) { link_to c.name, layered_assistant.public_panel_conversation_path(c), data: { turbo_frame: "assistant_panel", turbo_prefetch: false } } },
              { attribute: :messages_count, label: "Messages", render: ->(c) { c.messages_count || 0 } }
            ]
          ) %>
    <% end %>

    <%= form_with url: layered_assistant.public_panel_conversations_path(assistant_id: @assistant.id), method: :post do |f| %>
      <div class="l-ui-mt-4">
        <%= f.submit "Start conversation", class: "l-ui-button l-ui-button--primary" %>
      </div>
    <% end %>
  </div>
<% end %>
