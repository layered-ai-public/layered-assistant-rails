# Copy to .env.deploy and fill in the target, then deploy with bin/deploy.
# .env.deploy is gitignored so the origin server address stays out of the repo.
KAMAL_DEPLOY_IP=203.0.113.10
KAMAL_DEPLOY_DOMAIN=dummy.example.com
KAMAL_SSH_KEY=~/.ssh/id_rsa

# Decrypts test/dummy/config/credentials/production.yml.enc in the container.
# Use the contents of test/dummy/config/credentials/production.key - the key
# file is kept out of the image, so this is how the app gets it.
RAILS_MASTER_KEY=0123456789abcdef0123456789abcdef
